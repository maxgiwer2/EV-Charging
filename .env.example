APP_NAME="EV Charging Analytics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Host port published by the `web` container (docker-compose.yml).
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# docs/10 rule 7: store and compute in UTC, render Asia/Bangkok in the UI.
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Bangkok

APP_MAINTENANCE_DRIVER=file

# Reported by /health/ready so an operator can confirm which release answered.
# Set from CI, ideally to the git sha.
APP_VERSION=dev

# Reverse proxies whose X-Forwarded-* headers may be trusted, comma separated.
# Leave empty when nothing sits in front of the app. `*` trusts any proxy and
# must only be used where the network guarantees one -- otherwise a client can
# spoof the IP recorded in the audit trail (docs/02 FR-015).
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (MySQL 8+ required -- see database/schema.sql)
# `mysql` is the compose service name; use 127.0.0.1:33061 from the host.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ev_charging
DB_USERNAME=ev_charging
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret
DB_PORT_HOST=33061

SESSION_DRIVER=database
SESSION_LIFETIME=120
# docs/03: secure session cookies. Encryption on, cookie not readable by JS,
# and SameSite=lax to blunt CSRF. SESSION_SECURE_COOKIE must be true in
# production (served over HTTPS); it is false locally because dev is plain HTTP.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log

# ---------------------------------------------------------------------------
# Filesystem
# Receipts are NEVER written to the public disk. `receipts` is a private disk
# rooted outside public/ and served only through authorized controllers
# (docs/03 -> private receipt storage, AT-007).
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local
RECEIPT_DISK=receipts
RECEIPT_MAX_SIZE_KB=10240

# ---------------------------------------------------------------------------
# Queue -- OCR and AI run asynchronously (docs/03 -> async OCR jobs)
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# OCR provider (M2). The domain depends on OcrProviderInterface only; the
# driver below selects an adapter. `null` is a no-op adapter used in tests.
# Never commit real credentials (docs/03 -> no secrets in repository).
# ---------------------------------------------------------------------------
# `none` is a no-op adapter (do not use the literal "null" -- env() casts it).
# Set to `typhoon` and supply TYPHOON_API_KEY to enable real OCR.
OCR_DRIVER=none
OCR_TIMEOUT_SECONDS=60
OCR_CONFIDENCE_REVIEW_THRESHOLD=0.85

# Typhoon OCR (opentyphoon.ai). Get a key from the Typhoon playground.
# Never commit a real key.
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_API_KEY=
TYPHOON_MODEL=typhoon-ocr

# ---------------------------------------------------------------------------
# AI provider (M5). Advisory only -- deterministic business rules remain
# authoritative (architecture/system-architecture.md). The assistant never
# calculates: figures come from AnalyticsService and the model only phrases
# them. See docs/13-ai-assistant.md.
# ---------------------------------------------------------------------------
AI_DRIVER=none
AI_TIMEOUT_SECONDS=120
AI_MAX_TOKENS=512

# Ollama, self-hosted so financial data never leaves the deployment.
# Include the /v1 suffix: the adapter posts to {base_url}/chat/completions.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Production (docs/14-deployment.md)
# ---------------------------------------------------------------------------
# The application refuses to boot in production unless these hold:
#   APP_DEBUG=false
#   APP_URL=https://...
#   SESSION_SECURE_COOKIE=true
#   SESSION_ENCRYPT=true
#   APP_KEY set
# Verify before deploying with: php artisan app:check-production
